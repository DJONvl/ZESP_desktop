    <block type="zigbeeEvent.on">
      <value name="v1">
        <block type="text">
          <field name="TEXT">test</field>
        </block>
      </value>
    </block>
    <block type="field_oid">
      <value name="TEXT"></value>
    </block>-->
    <block type="report"></block>
    <block type="exec_sh">
      <value name="pth">
        <block type="text">
          <field name="TEXT">./myscript.sh</field>
        </block>
      </value>
    </block>
    <block type="playSound">
      <value name="v1">
        <block type="text">
          <field name="TEXT"></field>
        </block>
      </value>
      <value name="v2">
        <block type="text">
          <field name="TEXT">15000</field>
        </block>
      </value>
    </block>
    <block type="sayText">
      <field name="v3">ru</field>
      <value name="v1">
        <block type="text">
          <field name="TEXT">тест</field>
        </block>
      </value>
      <value name="v2">
        <block type="text">
          <field name="TEXT">15000</field>
        </block>
      </value>
    </block>
    <block type="cmd_ON_OFF"></block>
    <block type="cmdSetLevel"></block>
    <block type="cmd_MILAMP">
      <field name="v3">1</field>
      <value name="v1">
        <block type="math_number">
          <field name="NUM">100</field>
        </block>
      </value>
      <value name="v2">
        <block type="colour_picker">
          <field name="COLOUR">#33cc00</field>
        </block>
      </value>
    </block>
    <block type="MI_light"></block>
    <block type="MI_button"></block>
    <block type="console_log"></block>
  </category>
  <category name="MQTT" colour="#93ff5b">
    <block type="mqtt_subscribe"></block>
    <block type="mqtt_msg_packet"></block>
    <block type="mqtt_Pub">
      <value name="v3">
        <block type="logic_boolean">
          <field name="BOOL">FALSE</field>
        </block>
      </value>
    </block>
  </category>
  <category name="Telegram_Bot" colour="#9816DE">
    <block type="telegram_on">
      <statement name="INTCODE">
        <block type="controls_if">
          <value name="IF0">
            <block type="logic_compare">
              <field name="OP">EQ</field>
              <value name="A">
                <block type="t_msg">
                  <field name="v3">t_msg.text</field>
                </block>
              </value>
              <value name="B">
                <block type="text">
                  <field name="TEXT">test</field>
                </block>
              </value>
            </block>
          </value>
        </block>
      </statement>
    </block>
    <block type="telegram_send"></block>
  </category>
  <category name="Time_Date" colour="#90a55b">
    <block type="time_compare_ex">
      <value name="OPTION"></value>
      <value name="USE_ACTUAL_TIME"></value>
      <value name="START_TIME">
        <shadow type="text">
          <field name="TEXT">12:00</field>
        </shadow>
      </value>
      <mutation end_time="false" actual_time="true"></mutation>
      <value name="END_TIME">
        <shadow type="text">
          <field name="TEXT">18:00</field>
        </shadow>
      </value>
      <value name="CUSTOM_TIME">
        <shadow type="text">
          <field name="TEXT">14:00</field>
        </shadow>
      </value>
    </block>
    <block type="time_compare">
      <value name="OPTION"></value>
      <value name="START_TIME"></value>
      <mutation end_time="false"></mutation>
      <value name="END_TIME"></value>
    </block>
    <block type="time_get">
      <value name="OPTION"></value>
      <mutation format="false" language="false"></mutation>
      <value name="FORMAT"></value>
      <value name="LANGUAGE"></value>
    </block>
  </category>
  <category name="Timeouts" colour="#93a55b">
    <block type="timeouts_settimeout"></block>
    <block type="timeouts_setinterval"></block>
    <block type="timeouts_cleartimeout"></block>
    <block type="timeouts_clearinterval"></block>
  </category>
  <category name="Converters" colour="#93a55b">
    <block type="convert_todec"></block>
    <block type="convert_tonumber"></block>
    <block type="convert_toboolean">
      <value name="VALUE"></value>
    </block>
    <block type="convert_tostring">
      <value name="VALUE"></value>
    </block>
    <block type="convert_type">
      <value name="ITEM"></value>
    </block>
    <block type="convert_to_date">
      <value name="VALUE"></value>
    </block>
    <block type="convert_from_date">
      <value name="VALUE"></value>
      <value name="OPTION"></value>
      <mutation format="false" language="false"></mutation>
      <value name="FORMAT"></value>
      <value name="LANGUAGE"></value>
    </block>
    <block type="convert_json2object">
      <value name="VALUE"></value>
    </block>
    <block type="convert_object2json">
      <value name="VALUE"></value>
      <value name="PRETTIFY"></value>
    </block>
    <block type="json_data">
      <value name="it">
        <block type="text">
          <field name="TEXT"></field>
        </block>
      </value>
    </block>
    <block type="convert_jsonata">
      <value name="EXPRESSION">
        <shadow type="text">
          <field name="TEXT">*</field>
        </shadow>
      </value>
      <value name="TARGET"></value>
    </block>
  </category>
