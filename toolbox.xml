      <block type="autolight"></block>
      <block type="hub_blinker"></block>
    </category>
    <category name="Zigbee events" colour="#c1c1c1">
      <block type="on_zigbee_event"></block>
      <block type="on_zigbee_event2"></block>
    </category>
  </category>
  <!-- <category name="ZESP" colour="#93a55b"> -->
  <category name="Devices" colour="#90a050">
    <!--marker.-->
  </category>
  <category name="ZESP_Functions" colour="#93a55b">
    <!-- <block type="servo"></block> -->
    <block type="DESCRIPTION">
      <value name="v1">
        <block type="text">
          <field name="TEXT"></field>
        </block>
      </value>
    </block>
    <block type="onEvent"></block>
    <block type="sendCmd"></block>
    <block type="attr_condition">
      <field name="VALUE">0</field>
    </block>
    <block type="request"></block>
    <!-- <block type="page_settings"></block> -->
